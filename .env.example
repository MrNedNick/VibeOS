# VibeOS — Environment variables
#
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.
#
# Without these vars the app runs in full offline / demo mode.
# Set them to activate Supabase auth + cloud sync.

# ── Supabase ────────────────────────────────────────────────────────────────
# Your Supabase project URL (found in Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe to expose in browser builds — RLS protects data)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Optional: OpenWeatherMap (for Dashboard weather widget) ─────────────────
# Get a free key at https://openweathermap.org/api
# Can also be set directly in Settings → API Keys inside the app
# VITE_OPENWEATHER_KEY=your_api_key_here

# ── Optional: AI provider (single seam — see src/core/composables/provider.ts)
# Defaults to Pollinations.ai (free, no key). Override to swap providers
# (Groq / Gemini / OpenAI-compatible) — endpoint + model are the only levers.
# VITE_AI_ENDPOINT=https://text.pollinations.ai/
# VITE_AI_MODEL=openai-fast   # only tier:anonymous Pollinations model (GPT-OSS 20B); others need a key since 2026-06
